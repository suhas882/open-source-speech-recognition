
{
  "manifest_version": 3,
  "name": "Open-Source Speech Recognition",
  "version": "1.2.0",
  "description": "Transcribe audio files and browser tabs locally with Faster-Whisper.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Speech Recognition",
    "default_popup": "popup.html"
  }
}
